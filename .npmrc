# Usar el registro oficial de npm
registry=https://registry.npmjs.org/

# Guardar dependencias automáticamente en package.json
save=true

# Instalar siempre la versión exacta (sin ^ o ~)
save-exact=true

# Número de intentos de descarga en caso de fallo
fetch-retries=3

# Tiempo mínimo y máximo entre reintentos (ms)
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Forzar colores en la salida de CLI
color=true

# Evitar warnings de auditoría en entornos CI/CD
audit=false
